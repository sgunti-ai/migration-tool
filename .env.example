# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Microsoft 365 Azure AD / Entra ID App Credentials for Tenant Migration
# Source Tenant MSAL App Registration
SOURCE_CLIENT_ID=""
SOURCE_CLIENT_SECRET=""

# Target Tenant MSAL App Registration
TARGET_CLIENT_ID=""
TARGET_CLIENT_SECRET=""

# Security & Data at Rest Encryption key (32 bytes hex or string)
ENCRYPTION_SECRET=""
SESSION_SECRET=""

# Console authentication (different from M365 workload tenant consent)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
ADMIN_EMAILS=""
DEMO_MODE="false"
LIVE_MIGRATION_ENABLED="false"
