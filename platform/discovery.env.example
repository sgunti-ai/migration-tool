NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://discovery:replace-with-secret@postgres:5432/discovery?schema=public
REDIS_URL=redis://redis:6379
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_AUDIENCE=YOUR_DISCOVERY_API_AUDIENCE
OIDC_JWKS_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/discovery/v2.0/keys
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DISCOVERY_GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
