NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://migration:change-me@localhost:5432/migration
REDIS_URL=redis://localhost:6379
DEMO_MODE=false
# These identify a dedicated API token issuer and audience, NOT arbitrary client-supplied roles.
OIDC_ISSUER=https://login.microsoftonline.com/TENANT_GUID/v2.0
OIDC_AUDIENCE=API_APPLICATION_ID
OIDC_JWKS_URL=https://login.microsoftonline.com/TENANT_GUID/discovery/v2.0/keys
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
